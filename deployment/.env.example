# Copy to .env in this same folder and change every value before any
# real (non-local-demo) deployment. docker-compose.yml falls back to the
# *_dev_only defaults shown here so `docker-compose up` still works out
# of the box for local development, but nothing here should be reused
# outside a laptop.

DB_NAME=taskmgmt
DB_USER=taskmgmt
DB_PASSWORD=taskmgmt_dev_only

JWT_SECRET=dev-only-secret-change-me-please-min-32-bytes-long
JWT_EXPIRY_MINUTES=60

GRAFANA_ADMIN_PASSWORD=admin
